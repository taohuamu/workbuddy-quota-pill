' Quota Sentinel - watchdog (generated by --install, do not edit by hand)
' Single job: if WorkBuddy is running and the widget is not, start the widget.
' The widget itself runs in follow mode and exits ~10s after WorkBuddy quits,
' so it truly lives and dies with WorkBuddy (no 90MB python resident at login).
' Comments stay ASCII on purpose: this file is written as ANSI by the installer.
Option Explicit
Dim sh, fso, svc, q, q2, pyw, script, here, suppressFile, lastTry, blocked
Set sh = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")
here = "__HERE__"
pyw = "__PYW__"
script = here & "\quota_tray.py"
suppressFile = "__SUPPRESS__"
lastTry = 0

Do
  On Error Resume Next
  Set svc = GetObject("winmgmts:\\.\root\cimv2")
  Set q = svc.ExecQuery("select ProcessId from Win32_Process where Name='WorkBuddy.exe'")
  If Err.Number = 0 Then
    If q.Count > 0 Then
      ' User closed the widget by hand: stay quiet for 15 minutes.
      blocked = False
      If fso.FileExists(suppressFile) Then
        If DateDiff("s", fso.GetFile(suppressFile).DateLastModified, Now) < 900 Then blocked = True
      End If
      If Not blocked Then
        Set q2 = svc.ExecQuery("select ProcessId from Win32_Process where Name='pythonw.exe' and CommandLine like '%quota_tray.py%'")
        If Err.Number = 0 Then
          If q2.Count = 0 And (lastTry = 0 Or (Timer - lastTry) > 3) Then
            lastTry = Timer
            sh.CurrentDirectory = here
            sh.Run """" & pyw & """ """ & script & """ --grace 120", 0, False
          End If
        End If
      End If
    End If
  End If
  Err.Clear
  On Error Goto 0
  WScript.Sleep 5000
Loop
